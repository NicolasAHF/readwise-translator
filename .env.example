# ── Readwise ──────────────────────────────────────────────
# https://readwise.io/access_token
READWISE_TOKEN=

# ── Proveedor de LLM ──────────────────────────────────────
# "openai-compatible" (Gemini, Groq, Cerebras, OpenRouter, Ollama…) o "anthropic"
PROVIDER=openai-compatible

# Gemini gratis (Google AI Studio → https://aistudio.google.com/apikey)
# Ojo: en el free tier, fuera de la UE Google puede usar los prompts para entrenar.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Mirá los modelos y límites vigentes en AI Studio; el alias "latest" apunta al Flash actual.
LLM_MODEL=gemini-flash-latest
# Modelos con razonamiento (Gemini 3, o1-like): none | minimal | low | medium | high.
# Gemini 3 no permite apagarlo; "low" lo minimiza. Setearlo además suma margen de tokens
# de salida para que el razonamiento no corte la traducción. Dejalo vacío en modelos sin razonamiento.
LLM_REASONING_EFFORT=low
# Free tier de Gemini: 5–15 RPM según modelo. Dejá margen.
REQUESTS_PER_MINUTE=5

# Otras opciones (descomentá un bloque):
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1          LLM_MODEL=llama-3.3-70b-versatile
# Cerebras:   LLM_BASE_URL=https://api.cerebras.ai/v1              LLM_MODEL=<ver dashboard>
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_MODEL=<modelo>:free
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1               LLM_MODEL=qwen3:14b   (sin LLM_API_KEY)

# Claude (pago)
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# ── Traducción ────────────────────────────────────────────
TARGET_LANG=es
# Tag que marcás en Reader para que el script lo levante en modo --tag
TRIGGER_TAG=translate
# Qué hacer con el original después de guardar la traducción: keep | archive | delete
# "delete" archiva en vez de borrar si el original tiene highlights, una nota,
# no tiene URL web de origen, o la traducción quedó incompleta.
ORIGINAL_ACTION=keep
# Tamaño máx. de cada chunk de HTML (caracteres). Menos = más requests pero más robusto con modelos chicos.
CHUNK_CHARS=12000
# Chunks traducidos en paralelo (1 en free tiers; 3+ con proveedores pagos)
CONCURRENCY=1

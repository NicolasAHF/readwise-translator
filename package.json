{
  "name": "readwise-translator",
  "version": "1.0.0",
  "description": "Traduce documentos completos de Readwise Reader con Claude y los guarda como documento nuevo",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "translate": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
